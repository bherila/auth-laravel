{
  "name": "bherila/auth-laravel",
  "description": "Shared Laravel authentication services for BWH applications.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/bherila/auth-laravel",
  "support": {
    "issues": "https://github.com/bherila/auth-laravel/issues",
    "source": "https://github.com/bherila/auth-laravel"
  },
  "require": {
    "php": "^8.4",
    "illuminate/auth": "^13.0",
    "illuminate/cache": "^13.0",
    "illuminate/contracts": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/hashing": "^13.0",
    "illuminate/http": "^13.0",
    "illuminate/mail": "^13.0",
    "illuminate/queue": "^13.0",
    "illuminate/routing": "^13.0",
    "illuminate/support": "^13.0",
    "illuminate/validation": "^13.0",
    "lcobucci/jwt": "^5.6",
    "symfony/uid": "^7.4 || ^8.0",
    "web-auth/webauthn-lib": "^5.3.5"
  },
  "require-dev": {
    "laravel/passport": "^13.0",
    "orchestra/testbench": "^11.0"
  },
  "suggest": {
    "laravel/passport": "Required only when using the optional OAuth authorization-server helpers."
  },
  "autoload": {
    "psr-4": {
      "BWH\\Auth\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BWH\\Auth\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "laravel": {
      "providers": [
        "BWH\\Auth\\AuthServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
